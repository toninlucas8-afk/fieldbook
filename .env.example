# Database Supabase: Project settings > Database > Connection string > URI
# Usa la versione "Session pooler" (porta 5432 o 6543) e sostituisci la password.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Cloudflare R2: dashboard R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fieldbook

# Solo per il primissimo avvio: creano il tuo accesso da amministratore.
# Dopo che sei entrato, cambia il PIN dall'app e togli queste due righe.
ADMIN_NOME=Luca
ADMIN_PIN=

NODE_ENV=production
